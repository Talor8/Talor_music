@{
    ViewData["Title"] = "Music Time Machine";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Special+Elite&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    /* רקע נייר טקסטורלי עדין */
    body {
        background-color: #fcfbf7;
        background-image: url('https://www.transparenttextures.com/patterns/cream-paper.png');
        font-family: 'Playfair Display', serif;
        color: #3e3226;
    }

    .hero-section {
        padding: 100px 20px;
        text-align: center;
        background: radial-gradient(circle, #fcfbf7 0%, #edeadd 100%);
        border-bottom: 2px solid #d2b48c;
    }

    .hero-title {
        font-size: 4rem;
        color: #2a221b;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    /* כפתור וינטאג' ראשי */
    .btn-vintage {
        background-color: #8b5e34;
        color: white;
        padding: 15px 30px;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        transition: 0.3s;
        font-family: 'Special Elite', cursive;
        margin: 5px;
    }

        .btn-vintage:hover {
            background-color: #5d3f23;
            color: #fff;
        }

    /* כפתור התחברות משני */
    .btn-login {
        background-color: transparent;
        color: #8b5e34;
        padding: 15px 30px;
        border: 2px solid #8b5e34;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: 0.3s;
        font-family: 'Special Elite', cursive;
        margin: 5px;
    }

        .btn-login:hover {
            background-color: #8b5e34;
            color: white;
        }

    .feature-card {
        background: #fdfaf6;
        border: 1px solid #d2b48c;
        padding: 30px;
        box-shadow: 5px 5px 15px rgba(0,0,0,0.05);
        transition: 0.3s;
    }
</style>

<div class="hero-section">
    <h1 class="hero-title">Music Time Machine</h1>
    <p class="lead" style="font-family: 'Special Elite', cursive;">--- חפירה בארכיון הצלילים האבודים ---</p>

    <div class="mt-4">
        <a asp-controller="Songs" asp-action="Index" class="btn btn-vintage">היכנס לעולם המוזיקה</a>

        @if (!User.Identity.IsAuthenticated)
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-login">התחברות</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Logout" class="btn btn-login">התנתק</a>
        }
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card text-center">
                <i class="bi bi-vinyl" style="font-size: 2rem; color: #8b5e34;"></i>
                <h4 class="mt-3">אוסף נדיר</h4>
                <p>צלילים שלא שומעים בכל מקום, שמורים בקפידה.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card text-center">
                <i class="bi bi-shield-check" style="font-size: 2rem; color: #8b5e34;"></i>
                <h4 class="mt-3">רכישה בטוחה</h4>
                <p>קנייה מאובטחת ופרטיות מלאה בתהליך התשלום.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card text-center">
                <i class="bi bi-music-note-list" style="font-size: 2rem; color: #8b5e34;"></i>
                <h4 class="mt-3">חווית האזנה</h4>
                <p>איכות ללא פשרות, מותאמת לאוזניים של היום.</p>
            </div>
        </div>
    </div>
</div>