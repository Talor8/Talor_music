@{
    ViewData["Title"] = "Welcome to MusicStore";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Assistant', sans-serif;
        background: #f8f9fa;
    }

    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1514525253344-f856d0a42617?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
        background-size: cover;
        background-position: center;
        color: white;
        padding: 100px 0;
        border-radius: 0 0 50px 50px;
        margin-bottom: 50px;
    }

    .feature-card {
        border: none;
        border-radius: 20px;
        transition: 0.3s;
        background: white;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

        .feature-card:hover {
            transform: translateY(-10px);
        }

    .btn-primary-music {
        background: #1db954;
        border: none;
        border-radius: 30px;
        padding: 12px 35px;
        font-weight: 700;
        color: white;
        text-transform: uppercase;
        text-decoration: none;
        display: inline-block;
    }

        .btn-primary-music:hover {
            background: #1ed760;
            color: white;
        }

    .btn-login-outline {
        border: 2px solid white;
        color: white;
        border-radius: 30px;
        padding: 12px 35px;
        font-weight: 700;
        text-transform: uppercase;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-login-outline:hover {
            background: white;
            color: #333;
        }
</style>

<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">Your Soundtrack, Your Way</h1>
        <p class="lead mb-5 opacity-75">גלו אמנים חדשים, צרו פלייליסטים והורידו את המוזיקה שאתם אוהבים.</p>

        <div class="d-flex justify-content-center gap-3">
            @* כפתור כניסה לחנות - תמיד מופיע *@
            <a asp-controller="Songs" asp-action="Index" class="btn btn-primary-music btn-lg shadow">התחילו להאזין</a>

            @* הצגת כפתורי התחברות רק אם המשתמש לא מחובר *@
            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-login-outline btn-lg">התחברו</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg rounded-pill px-4 border-2">הצטרפו עכשיו</a>
            }
            else
            {
                @* אם הוא מחובר, נראה לו הודעה נחמדה במקום כפתורי רישום *@
                <span class="align-self-center ms-3 fw-bold text-success text-uppercase">ברוך הבא חזרה! ♫</span>
            }
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="card feature-card p-4">
                <i class="bi bi-music-note-list text-success fs-1 mb-3"></i>
                <h4 class="fw-bold">ספרייה ענקית</h4>
                <p class="text-muted">אלפי שירים מכל הז'אנרים מחכים לכם במרחק קליק.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card feature-card p-4">
                <i class="bi bi-person-check text-success fs-1 mb-3"></i>
                <h4 class="fw-bold">אמנים מובילים</h4>
                <p class="text-muted">עקבו אחרי האמנים האהובים עליכם וקבלו עדכונים.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card feature-card p-4">
                <i class="bi bi-shield-lock text-success fs-1 mb-3"></i>
                <h4 class="fw-bold">רכישה בטוחה</h4>
                <p class="text-muted">מערכת תשלומים מאובטחת וגישה מיידית לקבצים.</p>
            </div>
        </div>
    </div>
</div>