@model Talor_music.Models.Artist

@{
    ViewData["Title"] = "הוספת אמן חדש";
}

@* הוספת לינק לפונטים ואייקונים *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;700&display=swap" rel="stylesheet">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        font-family: 'Assistant', sans-serif;
    }

    .create-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        background: #fff;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card-header-custom {
        background: linear-gradient(45deg, #6a11cb 0%, #2575fc 100%);
        color: white;
        padding: 30px;
        text-align: center;
        border: none;
    }

    .form-control-custom {
        border-radius: 10px;
        padding: 12px;
        border: 2px solid #eee;
        transition: all 0.3s;
    }

        .form-control-custom:focus {
            border-color: #2575fc;
            box-shadow: 0 0 10px rgba(37, 117, 252, 0.2);
        }

    .btn-submit {
        background: linear-gradient(45deg, #11998e, #38ef7d);
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
    }

        .btn-submit:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(56, 239, 125, 0.4);
        }

    .back-link {
        color: #666;
        text-decoration: none;
        transition: color 0.3s;
    }

        .back-link:hover {
            color: #2575fc;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="create-card">
                <div class="card-header-custom">
                    <i class="bi bi-mic-fill mb-3" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold">הוספת אמן חדש</h2>
                    <p class="mb-0 opacity-75">הוסף כוכב חדש לגלריית המוזיקה שלך</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-secondary">
                                <i class="bi bi-person-badge me-1"></i> שם האמן
                            </label>
                            <input asp-for="Name" class="form-control form-control-custom" placeholder="למשל: עומר אדם, קולדפליי..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-submit text-white shadow-sm">
                                <i class="bi bi-plus-circle me-2"></i> צור אמן חדש
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light border-0 py-3 text-center">
                    <a asp-action="Index" class="back-link">
                        <i class="bi bi-arrow-left-circle me-1"></i> חזרה לרשימה
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}