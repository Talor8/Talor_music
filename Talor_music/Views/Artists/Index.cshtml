@model IEnumerable<Talor_music.Models.Artist>

@{
    ViewData["Title"] = "נבחרת האמנים";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Special+Elite&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f4ece0;
        background-image: url('https://www.transparenttextures.com/patterns/cream-paper.png');
        font-family: 'Special Elite', cursive;
        color: #4a3728;
    }

    .page-header {
        background: #e8dcc8;
        border-bottom: 3px solid #a68966;
        padding: 60px 0;
        margin-bottom: 40px;
        text-align: center;
    }

        .page-header h1 {
            font-family: 'Playfair Display', serif;
            color: #2c2016;
        }

    .artist-card {
        background: #fdfaf6;
        border: 1px solid #c5b396 !important;
        border-radius: 0 !important;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.08);
        transition: 0.3s;
    }

        .artist-card:hover {
            background: #f4ece0;
            transform: translateY(-5px);
            box-shadow: 5px 5px 15px rgba(0,0,0,0.1);
        }

    .artist-icon {
        background: #d3c4a8;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4a3728;
        border: 1px solid #a68966;
        font-size: 1.8rem;
    }

    .btn-action {
        border-radius: 0;
        padding: 6px 14px;
        font-size: 0.85rem;
        border: 1px solid #4a3728;
        color: #4a3728;
        background: transparent;
        transition: 0.2s;
    }

        .btn-action:hover {
            background: #a68966;
            color: white;
            border-color: #a68966;
        }

    .btn-create {
        background: #4a3728;
        color: white;
        border: none;
        padding: 10px 25px;
        text-decoration: none;
        letter-spacing: 1px;
    }
</style>

<div class="page-header">
    <div class="container">
        <h1 class="display-4 fw-bold">נבחרת האמנים</h1>
        <p>--- המוחות שמאחורי הצלילים ---</p>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-create mt-3">
                <i class="bi bi-plus-lg"></i> הוספת אמן חדש
            </a>
        }
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card artist-card h-100 p-3">
                    <div class="d-flex align-items-center">
                        <div class="artist-icon me-3">
                            <i class="bi bi-mic-fill"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="mb-1" style="font-family: 'Playfair Display', serif;">@Html.DisplayFor(modelItem => item.Name)</h4>
                            <p class="small text-muted mb-0">אמן בארכיון</p>
                        </div>
                    </div>

                    <hr class="my-3" style="border-top: 1px solid #a68966;">

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Details" asp-route-id="@item.ArtistID" class="btn btn-action">
                            <i class="bi bi-info-circle"></i> פרטים
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.ArtistID" class="btn btn-action">
                                <i class="bi bi-pencil"></i> עריכה
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.ArtistID" class="btn btn-action text-danger">
                                <i class="bi bi-trash"></i> מחיקה
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
