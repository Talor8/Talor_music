@model Talor_music.Models.Artist

@{
    ViewData["Title"] = Model.Name;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-5">
    <div class="row">
        @* צד ימין: פרטי האמן *@
        <div class="col-md-4 text-center">
            <div class="card shadow-sm p-4 border-0" style="border-radius: 20px; background: linear-gradient(145deg, #ffffff, #f0f0f0);">
                <div class="display-1 text-primary mb-3">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h2 class="fw-bold">@Model.Name</h2>
                <hr />
                <div class="d-grid gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.ArtistID" class="btn btn-warning">עריכת אמן</a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">חזרה לרשימה</a>
                </div>
            </div>
        </div>

        @* צד שמאל: רשימת השירים *@
        <div class="col-md-8">
            <h3 class="mb-4"><i class="bi bi-music-note-list me-2"></i>השירים של @Model.Name</h3>

            @if (Model.Songs != null && Model.Songs.Any())
            {
                <div class="list-group shadow-sm">
                    @foreach (var song in Model.Songs)
                    {
                        <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-play-circle-fill text-primary fs-3 me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">@song.Title</h6>
                                    <small class="text-muted">ID: #@song.SongID</small>
                                </div>
                            </div>

                            @* נגן מתוקן - קורא את הנתיב ישירות מהדאטהבייס *@
                            <audio controls style="height: 30px;">
                                <source src="@song.AudioFilePath" type="audio/mpeg">
                                הדפדפן שלך לא תומך בנגן.
                            </audio>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info border-0 shadow-sm">
                    <i class="bi bi-info-circle me-2"></i>לא נמצאו שירים לאמן זה במערכת.
                </div>
            }
        </div>
    </div>
</div>
