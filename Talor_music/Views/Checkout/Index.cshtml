@model Talor_music.Models.CheckoutViewModel

@{
    ViewData["Title"] = "תשלום";
}

<div class="container mt-5">
    <h2>רכישת פלייליסט: @Model.PlaylistName</h2>

    <div class="alert alert-info">
        <strong>לתשלום:</strong> ₪@Model.TotalPrice
        <br />
        <small>(המחיר קוזז בהתאם לשירים שכבר קיימים בחשבונך!)</small>
    </div>

    <div class="row">
        <div class="col-md-6 border p-4 shadow-sm bg-light">
            <form asp-action="ProcessPayment" asp-controller="Checkout" method="post">
                @* הודעות שגיאה כלליות (כמו "התשלום נדחה") יופיעו כאן *@
                <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

                @* שדות חבויים כדי שהמידע לא יאבד בשליחה *@
                <input type="hidden" asp-for="PlaylistID" />
                <input type="hidden" asp-for="TotalPrice" />
                <input type="hidden" asp-for="PlaylistName" />

                <div class="form-group mb-3">
                    <label class="form-label">מספר כרטיס אשראי:</label>
                    <input asp-for="CardNumber" class="form-control" placeholder="1234-5678-9012-3456" />
                    <span asp-validation-for="CardNumber" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">תוקף (MM/YY):</label>
                        @* תיקון: שיניתי מ-ExpiryDate ל-ExpirationDate כדי שיתאים לבקר *@
                        <input asp-for="ExpirationDate" class="form-control" placeholder="12/26" />
                        <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">CVV:</label>
                        <input asp-for="CVV" class="form-control" placeholder="123" />
                        <span asp-validation-for="CVV" class="text-danger"></span>
                    </div>
                </div>

                <hr />
                <button type="submit" class="btn btn-success btn-lg w-100">סיים רכישה ✅</button>
                <a asp-action="Index" asp-controller="Store" class="btn btn-link w-100 mt-2">ביטול וחזרה לחנות</a>
            </form>
        </div>

        <div class="col-md-4 ms-md-4 mt-4 mt-md-0">
            <div class="card card-body bg-warning-subtle">
                <h5>💳 כרטיסים לבדיקה (API):</h5>
                <ul class="small">
                    <li><strong>מספר:</strong> 1111222233334444<br><strong>תוקף:</strong> 01/30 | <strong>CVV:</strong> 999</li>
                    <li><strong>מספר:</strong> 4580123456789012<br><strong>תוקף:</strong> 12/28 | <strong>CVV:</strong> 123</li>
                </ul>
                <p class="small text-muted mt-2">כל כרטיס אחר יידחה אוטומטית על ידי המערכת.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
