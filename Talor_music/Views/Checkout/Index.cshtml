@model Talor_music.Models.CheckoutViewModel

<h2>רכישת פלייליסט: @Model.PlaylistName</h2>

<div class="alert alert-info">
    <strong>לתשלום:</strong> ₪@Model.TotalPrice
    <br />
    <small>(המחיר קוזז בהתאם לשירים שכבר קיימים בחשבונך!)</small>
</div>

<form asp-action="CreateCheckoutSession" method="post">

    <input type="hidden" name="playlistId" value="@Model.PlaylistID" />

    <div class="alert alert-warning">
        לחיצה על הכפתור תעביר אותך לדף תשלום מאובטח ב-Stripe.
    </div>

    <br />
    <button type="submit" class="btn btn-success btn-lg">עבור לתשלום מאובטח</button>
</form>
//v