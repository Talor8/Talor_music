@{
    ViewData["Title"] = "רכישה בוצעה בהצלחה";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-5 text-center" dir="rtl">
    <div class="card shadow-sm mx-auto p-5" style="max-width: 500px; border-radius: 20px; border-top: 8px solid #198754;">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>

        <h2 class="mt-4 fw-bold">התשלום התקבל בהצלחה!</h2>
        <p class="text-muted mt-2 fs-5">איזה כיף! השירים מהפלייליסט נוספו לחשבון שלך.</p>

        <div class="mt-5">
            <a asp-controller="PlayListSongs" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2">
                <i class="bi bi-music-note-list me-2"></i> חזרה לפלייליסטים שלי
            </a>
        </div>
    </div>
</div>