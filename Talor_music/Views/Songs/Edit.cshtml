@model Talor_music.Models.Song

@{
    ViewData["Title"] = "Edit Song";
}

@* חיבור לספריות עיצוב *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    /* הסטייל שלך נשאר אותו דבר - הוא מצוין */
    body {
        background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
        font-family: 'Assistant', sans-serif;
        min-height: 100vh;
    }

    .edit-song-card {
        border: none;
        border-radius: 25px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        background: white;
        overflow: hidden;
        margin-top: 50px;
    }

    .card-header-edit {
        background: linear-gradient(45deg, #212529 0%, #343a40 100%);
        color: white;
        padding: 30px;
        text-align: center;
    }

    .form-label {
        font-weight: 700;
        color: #495057;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 12px;
        padding: 12px 15px;
        border: 2px solid #f1f3f5;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #1db954;
            box-shadow: 0 0 10px rgba(29, 185, 84, 0.1);
        }

    .current-media-box {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 15px;
        border: 1px solid #e9ecef;
        margin-top: 10px;
    }

    .btn-save-edit {
        background: #1db954;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-weight: 800;
        text-transform: uppercase;
        transition: 0.3s;
        width: 100%;
    }

        .btn-save-edit:hover {
            background: #1ed760;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(29, 185, 84, 0.2);
        }

    .upload-label-custom {
        display: block;
        padding: 10px;
        background: #e9ecef;
        border-radius: 10px;
        text-align: center;
        cursor: pointer;
        font-weight: 600;
        transition: 0.2s;
    }

        .upload-label-custom:hover {
            background: #dee2e6;
        }
</style>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="edit-song-card">
                <div class="card-header-edit">
                    <i class="bi bi-pencil-square mb-2" style="font-size: 2.5rem;"></i>
                    <h2 class="fw-bold">Edit Song Details</h2>
                    <p class="mb-0 opacity-75">עדכון פרטי השיר: @Model.Title</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        @* שדות נסתרים - קריטי להעברת הנתונים הקיימים ל-Controller *@
                        <input type="hidden" asp-for="SongID" />
                        <input type="hidden" asp-for="ImagePath" />
                        <input type="hidden" asp-for="AudioFilePath" />

                        <div class="row">
                            <div class="col-md-7">
                                <div class="mb-4">
                                    <label asp-for="Title" class="form-label">Song Title</label>
                                    <input asp-for="Title" class="form-control" />
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Genre" class="form-label">Genre</label>
                                        <input asp-for="Genre" class="form-control" />
                                        <span asp-validation-for="Genre" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Price" class="form-label">Price (₪)</label>
                                        <input asp-for="Price" class="form-control" />
                                        <span asp-validation-for="Price" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="ArtistID" class="form-label">Artist</label>
                                    <select asp-for="ArtistID" class="form-select" asp-items="ViewBag.ArtistID"></select>
                                    <span asp-validation-for="ArtistID" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-5">
                                <div class="mb-4">
                                    <label class="form-label">Cover Image</label>
                                    @* שים לב: ה-name חייב להיות imageFile בדיוק כמו בקונטרולר *@
                                    <input type="file" name="imageFile" id="imageFile" class="form-control d-none" accept="image/*" />
                                    <label for="imageFile" class="upload-label-custom mb-2">
                                        <i class="bi bi-image me-1"></i> Change Image
                                    </label>

                                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                                    {
                                        <div class="current-media-box text-center">
                                            <img src="@Url.Content("~" + Model.ImagePath)" class="img-fluid rounded shadow-sm" style="max-height: 150px;" />
                                            <div class="small text-muted mt-2">Current Cover</div>
                                        </div>
                                    }
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Audio File (MP3)</label>
                                    @* שים לב: ה-name חייב להיות audioFile בדיוק כמו בקונטרולר *@
                                    <input type="file" name="audioFile" id="audioFile" class="form-control d-none" accept="audio/*" />
                                    <label for="audioFile" class="upload-label-custom mb-2">
                                        <i class="bi bi-mic me-1"></i> Change Audio
                                    </label>

                                    @if (!string.IsNullOrEmpty(Model.AudioFilePath))
                                    {
                                        <div class="current-media-box">
                                            <audio controls class="w-100" style="height: 30px;">
                                                <source src="@Url.Content("~" + Model.AudioFilePath)" type="audio/mpeg">
                                            </audio>
                                            <div class="small text-muted mt-2 text-center">Current Preview</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-save-edit">
                                <i class="bi bi-check-circle me-2"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted text-center">
                                Cancel and go back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // שיפור: הצגת שם הקובץ שנבחר במקום alert מציק
        document.getElementById('imageFile').onchange = function() {
            if(this.files[0]) {
                const label = document.querySelector('label[for="imageFile"]');
                label.innerHTML = '<i class="bi bi-check"></i> ' + this.files[0].name;
                label.style.background = "#d4edda";
            }
        };
        document.getElementById('audioFile').onchange = function() {
            if(this.files[0]) {
                const label = document.querySelector('label[for="audioFile"]');
                label.innerHTML = '<i class="bi bi-check"></i> ' + this.files[0].name;
                label.style.background = "#d4edda";
            }
        };
    </script>
}
