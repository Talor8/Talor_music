@model Talor_music.Models.Song

@{
    ViewData["Title"] = "Song Details - " + Model.Title;
}

@* חיבור לאייקונים ופונטים *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    body {
        background: #f0f2f5;
        font-family: 'Assistant', sans-serif;
    }

    .glass-card {
        background: white;
        border: none;
        border-radius: 30px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .detail-item {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 15px;
        transition: 0.3s;
    }

    .detail-icon {
        width: 40px;
        height: 40px;
        background: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 15px;
        @* שינוי לצד שמאל בגלל העברית *@
        color: #1db954;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .price-badge {
        font-size: 1.8rem;
        font-weight: 800;
        color: #1db954;
    }

    .btn-custom {
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: bold;
        transition: 0.3s;
    }
</style>

<div class="container mt-5 text-end" dir="rtl">
    @* הוספת כיוון עברית *@
    <div class="card glass-card shadow border-0 p-4">
        <div class="row align-items-center">

            @* צד ימין: תמונת השיר *@
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" class="img-fluid rounded shadow" style="max-height: 350px; border-radius: 20px;"
                         onerror="this.src='https://via.placeholder.com/300?text=No+Image'" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                        <i class="bi bi-music-note-beamed display-1 text-muted"></i>
                    </div>
                }
            </div>

            @* צד שמאל: פרטי השיר *@
            <div class="col-md-8">
                <h1 class="fw-bold display-4 mb-0">@Model.Title</h1>
                <h4 class="text-primary mb-4">@Model.Artist?.Name</h4>

                <div class="row mb-4">
                    @* ז'אנר *@
                    <div class="col-sm-6">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-tags-fill"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">ז'אנר</small>
                                <span class="fw-bold">@Model.Genre</span>
                            </div>
                        </div>
                    </div>

                    @* מחיר *@
                    <div class="col-sm-6">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">מחיר</small>
                                <span class="price-badge">₪@Model.Price</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* נגן שמע *@
                <div class="my-4 p-3 bg-light rounded shadow-sm border">
                    <h6 class="mb-3"><i class="bi bi-play-circle-fill me-2 text-success"></i>האזנה לקטע מהשיר:</h6>
                    @if (!string.IsNullOrEmpty(Model.AudioFilePath))
                    {
                        <audio controls class="w-100">
                            <source src="@Model.AudioFilePath" type="audio/mpeg">
                            הדפדפן שלך לא תומך בנגן.
                        </audio>
                    }
                    else
                    {
                        <p class="text-muted small mb-0 italic">לא הועלה קובץ שמע לשיר זה.</p>
                    }
                </div>

                @* כפתורי פעולה *@
                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-custom">חזרה לחנות</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.SongID" class="btn btn-warning btn-custom">עריכת שיר</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>