@model Talor_music.Models.Song

@{
    ViewData["Title"] = "Song Details - " + Model.Title;
}

@* חיבור לאייקונים ופונטים *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    body {
        background: #f0f2f5;
        font-family: 'Assistant', sans-serif;
    }

    .song-details-container {
        margin-top: 50px;
        margin-bottom: 50px;
    }

    .glass-card {
        background: white;
        border: none;
        border-radius: 30px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .cover-section {
        background: linear-gradient(135deg, #1db954 0%, #191414 100%);
        padding: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .main-cover {
        width: 300px;
        height: 300px;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        transition: transform 0.3s ease;
    }

        .main-cover:hover {
            transform: scale(1.02);
        }

    .info-section {
        padding: 40px;
    }

    .song-title {
        font-size: 3rem;
        font-weight: 800;
        color: #191414;
        margin-bottom: 0;
    }

    .artist-name {
        font-size: 1.5rem;
        color: #1db954;
        font-weight: 600;
    }

    .detail-item {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 15px;
    }

    .detail-icon {
        width: 40px;
        height: 40px;
        background: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        color: #1db954;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .price-badge {
        font-size: 2rem;
        font-weight: 800;
        color: #191414;
    }

    .btn-custom {
        border-radius: 50px;
        padding: 12px 30px;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-edit {
        background: #191414;
        color: white;
        border: none;
    }

        .btn-edit:hover {
            background: #000;
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container song-details-container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="glass-card">
                <div class="row g-0">
                    <div class="col-md-5 cover-section">
                        @{
                            var imgSrc = string.IsNullOrEmpty(Model.ImagePath)
                            ? Url.Content("~/images/placeholder.png")
                            : Url.Content("~/" + Model.ImagePath);
                        }
                        <img src="@imgSrc" alt="Cover for @Model.Title" class="main-cover" onerror="this.src='https://via.placeholder.com/300x300?text=No+Image'" />
                    </div>

                    <div class="col-md-7 info-section">
                        <div class="mb-4">
                            <span class="badge bg-success mb-2">שיר חדש בחנות</span>
                            <h1 class="song-title">@Model.Title</h1>
                            <p class="artist-name"><i class="bi bi-person-fill me-2"></i>@Model.Artist.Name</p>
                        </div>

                        <hr class="my-4 opacity-25">

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="detail-item">
                                    <div class="detail-icon"><i class="bi bi-music-note-list"></i></div>
                                    <div>
                                        <small class="text-muted d-block">ז'אנר</small>
                                        <strong>@Model.Genre</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="detail-item">
                                    <div class="detail-icon"><i class="bi bi-tag"></i></div>
                                    <div>
                                        <small class="text-muted d-block">מחיר</small>
                                        <strong class="price-badge">@String.Format("{0:C}", Model.Price)</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model?.SongID" class="btn btn-custom btn-edit">
                                <i class="bi bi-pencil-square me-2"></i>ערוך פרטי שיר
                            </a>
                            <a asp-action="Index" class="btn btn-custom btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>חזרה לרשימה
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
