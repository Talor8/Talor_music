@model IEnumerable<Talor_music.Models.Song>

@{
    ViewData["Title"] = "Music Store";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Special+Elite&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f4ece0;
        background-image: url('https://www.transparenttextures.com/patterns/cream-paper.png');
        font-family: 'Special Elite', cursive;
        color: #4a3728;
    }

    .store-header {
        background: #e8dcc8;
        border-bottom: 3px solid #a68966;
        padding: 60px 0;
        margin-bottom: 40px;
    }

        .store-header h1 {
            font-family: 'Playfair Display', serif;
            color: #2c2016;
        }

    .search-input {
        background: #f4ece0 !important;
        border: 1px solid #a68966 !important;
        color: #4a3728 !important;
        border-radius: 0 !important;
    }

    .song-row {
        background: #e8dcc8;
        border: 1px solid #c5b396 !important;
        border-radius: 0 !important;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
        margin-bottom: 15px;
        transition: 0.3s;
    }

        .song-row:hover {
            background: #dcd0bc;
        }

    .price-text {
        color: #8b7355;
        font-weight: 800;
        font-size: 1.1rem;
    }

    .btn-add-playlist {
        background: #a68966;
        border: none;
        border-radius: 0;
        color: white;
        padding: 8px 20px;
    }

        .btn-add-playlist:hover {
            background: #8b7355;
        }

    .btn-create-new {
        background: #4a3728;
        color: white;
        padding: 12px 30px;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .custom-audio {
        filter: sepia(100%) hue-rotate(20deg) brightness(0.8);
        height: 30px;
    }
</style>

<div class="store-header text-center">
    <div class="container">
        <h1 class="display-4 fw-bold mb-2">Music Library</h1>
        <p class="mb-4">--- ארכיון צלילים נצחי ---</p>

        <div class="row justify-content-center mb-4">
            <div class="col-md-7">
                <form asp-controller="Songs" asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text" name="searchString" value="@Context.Request.Query["searchString"]"
                           class="form-control search-input" placeholder="חפש שיר, אמן או סגנון...">
                    <button type="submit" class="btn btn-outline-dark" style="border-radius:0;">חפש</button>
                </form>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-create-new">הוסף שיר חדש</a>
        }
    </div>
</div>

<div class="container pb-5">
    @foreach (var item in Model)
    {
        <div class="card song-row p-3">
            <div class="d-flex align-items-center">
                <div class="cover-wrapper me-4" style="width:70px; height:70px; border:1px solid #4a3728;">
                    <img src="@item.ImagePath" class="song-img" style="width:100%; height:100%; object-fit:cover;"
                         onerror="this.src='https://via.placeholder.com/150?text=♫'" />
                </div>

                <div class="flex-grow-1">
                    <h5 class="mb-0 fw-bold">@item.Title</h5>
                    <p class="text-muted mb-0 small">
                        <i class="bi bi-person-fill"></i> @(item.Artist?.Name ?? "Unknown") |
                        <span style="background:#d3c4a8; padding: 2px 8px; border-radius:10px; color:#4a3728;">@item.Genre</span>
                    </p>
                </div>

                <div class="audio-preview-container me-4">
                    @if (!string.IsNullOrEmpty(item.AudioFilePath))
                    {
                        <audio controls class="custom-audio">
                            <source src="@item.AudioFilePath" type="audio/mpeg">
                        </audio>
                    }
                </div>

                <div class="me-4 price-text">@String.Format("{0:C}", item.Price)</div>

                <div class="action-icons me-3">
                    <a asp-action="Details" asp-route-id="@item.SongID" class="text-dark"><i class="bi bi-info-circle"></i></a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.SongID" class="text-dark"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.SongID" class="text-danger"><i class="bi bi-trash"></i></a>
                    }
                </div>

                @if (!User.IsInRole("Admin"))
                {
                    <div class="me-3">
                        <a asp-controller="PlayListSongs" asp-action="AddSongToPlayList" asp-route-songId="@item.SongID" class="btn btn-add-playlist">הוסף</a>
                    </div>
                }
            </div>
        </div>
    }
</div>