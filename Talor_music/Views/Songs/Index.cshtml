@model IEnumerable<Talor_music.Models.Song>

@{
    ViewData["Title"] = "Music Store";
}

@* חיבור לספריות עיצוב *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    body {
        background: #f4f7f6;
        font-family: 'Assistant', sans-serif;
    }

    .store-header {
        background: linear-gradient(135deg, #1db954 0%, #191414 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 40px 40px;
        margin-bottom: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .search-input {
        height: 55px;
        font-size: 1.1rem;
        border: none !important;
    }

    .song-row {
        background: white;
        border-radius: 15px;
        transition: all 0.3s ease;
        margin-bottom: 15px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .song-row:hover {
            transform: scale(1.01);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

    .cover-wrapper {
        width: 70px;
        height: 70px;
        overflow: hidden;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    }

    .song-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .genre-badge {
        background: #e9ecef;
        color: #495057;
        font-size: 0.75rem;
        padding: 5px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .price-text {
        color: #1db954;
        font-weight: 800;
        font-size: 1.1rem;
    }

    .btn-add-playlist {
        background: #1db954;
        border: none;
        border-radius: 25px;
        color: white;
        padding: 8px 20px;
        font-weight: bold;
    }

        .btn-add-playlist:hover {
            background: #1ed760;
            color: white;
        }

    .btn-create-new {
        background: white;
        color: #191414;
        font-weight: bold;
        border-radius: 25px;
        padding: 12px 30px;
        text-decoration: none;
    }

        .btn-create-new:hover {
            background: #1db954;
            color: white;
        }

    .action-icons a {
        color: #adb5bd;
        margin: 0 5px;
        font-size: 1.1rem;
        text-decoration: none;
    }

        .action-icons a:hover {
            color: #191414;
        }

    /* עיצוב חדש לנגן השמע */
    .audio-preview-container {
        min-width: 200px;
        margin: 0 20px;
    }

    .custom-audio {
        height: 30px;
        width: 180px;
        filter: grayscale(100%) opacity(0.7);
        transition: 0.3s;
    }

        .custom-audio:hover {
            filter: grayscale(0%) opacity(1);
        }
</style>

<div class="store-header text-center">
    <div class="container">
        <h1 class="display-4 fw-bold mb-2">Music Library</h1>
        <p class="opacity-75 mb-4">Discover, Listen, and Build your personal collection</p>

        <div class="row justify-content-center mb-4">
            <div class="col-md-7">
                <form asp-controller="Songs" asp-action="Index" method="get" class="position-relative shadow rounded-pill overflow-hidden">
                    <input type="text" name="searchString" value="@Context.Request.Query["searchString"]"
                           class="form-control search-input ps-5 rounded-pill"
                           placeholder="Search for songs, artists or genres...">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <button type="submit" class="btn btn-dark position-absolute top-50 end-0 translate-middle-y me-2 rounded-pill px-4" style="height: 40px;">
                        Search
                    </button>
                </form>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Create" class="btn-create-new">
                <i class="bi bi-plus-lg me-2"></i>Add New Song
            </a>
            @if (!string.IsNullOrEmpty(Context.Request.Query["searchString"]))
            {
                <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                    <i class="bi bi-x-circle me-2"></i>Clear Search
                </a>
            }
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
            <h3 class="mt-3">No songs found...</h3>
            <p class="text-muted">Try searching for something else or add a new song.</p>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="card song-row p-3">
            <div class="d-flex align-items-center">
                @* 1. תמונת השיר *@
                <div class="cover-wrapper me-4">
                    @{
                        var imgSrc = string.IsNullOrEmpty(item.ImagePath)
                        ? Url.Content($"~/images/songs/{item.SongID}.jpg")
                        : Url.Content("~/" + item.ImagePath);
                    }
                    <img src="@imgSrc" class="song-img" onerror="this.src='https://via.placeholder.com/150?text=♫'" />
                </div>

                @* 2. פרטי השיר והאמן *@
                <div class="flex-grow-1">
                    <h5 class="mb-0 fw-bold">@item.Title</h5>
                    <p class="text-muted mb-0 small">
                        <i class="bi bi-person-fill"></i> @(item.Artist != null ? item.Artist.Name : "Unknown Artist")
                        <span class="mx-2">|</span>
                        <span class="genre-badge">@item.Genre</span>
                    </p>
                </div>

                @* 3. נגן מוזיקה - השינוי החדש *@
                <div class="audio-preview-container">
                    @if (!string.IsNullOrEmpty(item.AudioFilePath))
                    {
                        <audio controls class="custom-audio">
                            <source src="@Url.Content("~/" + item.AudioFilePath)" type="audio/mpeg">
                        </audio>
                    }
                    else
                    {
                        <div class="text-muted small" style="font-size: 0.75rem;">
                            <i class="bi bi-mic-mute me-1"></i> No preview
                        </div>
                    }
                </div>

                @* 4. מחיר *@
                <div class="me-4 text-center">
                    <span class="price-text">@String.Format("{0:C}", item.Price)</span>
                </div>

                @* 5. אייקוני עריכה ופרטים *@
                <div class="action-icons me-3">
                    <a asp-action="Details" asp-route-id="@item.SongID"><i class="bi bi-info-circle"></i></a>
                    <a asp-action="Edit" asp-route-id="@item.SongID"><i class="bi bi-pencil-square"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.SongID" class="text-danger"><i class="bi bi-trash"></i></a>
                </div>

                @* 6. כפתור הוספה *@
                <div>
                    <a asp-controller="PlayListSongs" asp-action="AddSongToPlayList" asp-route-songId="@item.SongID" class="btn btn-add-playlist">
                        <i class="bi bi-plus-circle-fill me-1"></i> Add
                    </a>
                </div>
            </div>
        </div>
    }
</div>
