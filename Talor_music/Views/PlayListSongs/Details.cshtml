@model Talor_music.Models.PlayListSong

@{
    ViewData["Title"] = "Playlist Details";
    var allSongs = ViewBag.AllSongs as IEnumerable<Talor_music.Models.Song>;

    // התוספת שלנו לקיזוז: מביאים את השירים שנקנו
    var purchasedSongIds = ViewBag.PurchasedSongIds as List<int> ?? new List<int>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Assistant', sans-serif;
    }

    .playlist-banner {
        background: linear-gradient(135deg, #4158D0 0%, #C850C0 46%, #FFCC70 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 40px 40px;
        margin-bottom: 30px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .glass-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 25px;
    }

    .add-song-section {
        background: #fff;
        padding: 25px;
        border-radius: 20px;
        border: 2px dashed #C850C0;
    }

    .song-table thead {
        background: #f1f3f5;
    }

    .price-tag {
        color: #C850C0;
        font-weight: bold;
    }

    .btn-add {
        background: #C850C0;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: 0.3s;
        width: 100%;
    }

        .btn-add:hover {
            background: #4158D0;
            transform: translateY(-2px);
            color: white;
        }
</style>

<div class="playlist-banner text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">@Model.Title</h1>
    </div>
</div>

<div class="container pb-5" dir="rtl">
    <div class="row">
        @if (!User.IsInRole("Admin"))
        {
            <div class="col-lg-4 mb-4">
                <div class="add-song-section shadow-sm text-center">
                    <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>הוספת שיר</h5>
                    <form id="addSongForm" asp-action="AddSongToListAction" method="post">
                        <input type="hidden" name="playListId" value="@Model.PlaylistSongID" />
                        <select name="songId" id="songSelect" class="select2 w-100" onchange="this.form.submit()">
                            <option value="">חפש שיר...</option>
                            @if (allSongs != null)
                            {
                                foreach (var song in allSongs)
                                {
                                    <option value="@song.SongID">@song.Title (@song.Price ₪)</option>
                                }
                            }
                        </select>
                    </form>
                </div>
            </div>
        }

        <div class="col-lg-@(User.IsInRole("Admin") ? "12" : "8")">
            <div class="glass-card p-4">
                <table class="table align-middle song-table">
                    <thead>
                        <tr>
                            <th>שם השיר</th>
                            <th>מחיר</th>
                            <th>פעולות</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Songs)
                        {
                            <tr>
                                <td><strong>@s.Title</strong></td>
                                <td>
                                    @* כאן הבדיקה שלנו! האם השיר נקנה? *@
                                    @if (purchasedSongIds.Contains(s.SongID))
                                    {
                                        <span class="text-success fw-bold">נרכש (0 ₪)</span>
                                    }
                                    else
                                    {
                                        <span class="price-tag">₪@s.Price</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="RemoveSong" method="post">
                                        <input type="hidden" name="playlistId" value="@Model.PlaylistSongID" />
                                        <input type="hidden" name="songId" value="@s.SongID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="total-row">
                        <tr>
                            <td class="fw-bold">סה"כ לתשלום:</td>
                            @* וכאן הקיזוז בסכום הסופי *@
                            <td class="fw-bold" style="color: #C850C0;">₪@(Model.Songs?.Where(s => !purchasedSongIds.Contains(s.SongID)).Sum(s => s.Price) ?? 0)</td>
                            <td></td>
                        </tr>
                        @if (!User.IsInRole("Admin"))
                        {
                            <tr>
                                <td colspan="3" class="text-center pt-3">
                                    <form asp-controller="Checkout" asp-action="CreateCheckoutSession" method="post">
                                        <input type="hidden" name="playlistId" value="@Model.PlaylistSongID" />
                                        <button type="submit" class="btn btn-add">
                                            <i class="bi bi-cart-check me-2"></i> רכוש את הפלייליסט ב-Stripe
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center pt-3">
                                    <div class="alert alert-info">אתה צופה בפלייליסט כעורך/מנהל.</div>
                                </td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () { $('#songSelect').select2({ dir: "rtl" }); });
    </script>
}



