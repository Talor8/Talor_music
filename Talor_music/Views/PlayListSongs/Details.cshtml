@model Talor_music.Models.PlayListSong

@{
    ViewData["Title"] = "Playlist Details";
}

@* פונטים, אייקונים ו-Select2 *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Assistant', sans-serif;
    }

    /* Header מרשים */
    .playlist-banner {
        background: linear-gradient(135deg, #4158D0 0%, #C850C0 46%, #FFCC70 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 40px 40px;
        margin-bottom: 30px;
        shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .glass-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 25px;
    }

    /* עיצוב בחירת שיר */
    .add-song-section {
        background: #fff;
        padding: 25px;
        border-radius: 20px;
        border: 2px dashed #C850C0;
    }

    .select2-container--default .select2-selection--single {
        border-radius: 10px;
        height: 45px;
        border: 1px solid #ddd;
        padding-top: 8px;
    }

    /* טבלת שירים */
    .song-table thead {
        background: #f1f3f5;
    }

    .song-table th {
        border: none;
        color: #6c757d;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    .song-table tbody tr {
        transition: 0.3s;
    }

        .song-table tbody tr:hover {
            background: #fdf2ff;
        }

    .price-tag {
        color: #C850C0;
        font-weight: bold;
    }

    .btn-action {
        border-radius: 10px;
        font-weight: 600;
    }

    .btn-add {
        background: #C850C0;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-add:hover {
            background: #4158D0;
            transform: translateY(-2px);
            color: white;
        }
</style>

<div class="playlist-banner text-center">
    <div class="container">
        <i class="bi bi-collection-play mb-3" style="font-size: 3.5rem;"></i>
        <h1 class="display-4 fw-bold">@Model.Title</h1>
        <div class="d-flex justify-content-center gap-3 opacity-75">
            <span><i class="bi bi-person"></i> Customer: @Model.CustomerID</span>
            <span>|</span>
            <span><i class="bi bi-calendar3"></i> Added: @Model.DateAdded.ToShortDateString()</span>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="add-song-section shadow-sm text-center">
                <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Add Song to List</h5>
                <form asp-action="AddSongToListAction" method="get">
                    <input type="hidden" name="playListId" value="@Model.PlaylistSongID" />
                    <div class="mb-3 text-start">
                        <select name="songId" class="select2 w-100">
                            <option value="">Choose a song...</option>
                            @if (ViewBag.Songs != null)
                            {
                                foreach (var song in ViewBag.Songs)
                                {
                                    <option value="@song.SongID">@song.Title (@song.Genre)</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-add w-100 shadow-sm">
                        Confirm & Add
                    </button>
                </form>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-action="Edit" asp-route-id="@Model?.PlaylistSongID" class="btn btn-outline-dark btn-action flex-grow-1 me-2">
                    <i class="bi bi-pencil"></i> Edit Info
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-action flex-grow-1">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="glass-card p-4">
                <h4 class="fw-bold mb-4"><i class="bi bi-music-note-list me-2"></i>Playlist Content</h4>

                @if (Model.Songs != null && Model.Songs.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle song-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Artist</th>
                                    <th>Genre</th>
                                    <th>Price</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Songs)
                                {
                                    <tr>
                                        <td><strong class="text-dark">@s.Title</strong></td>
                                        <td><span class="text-muted">@(s.Artist != null ? s.Artist.Name : "Unknown")</span></td>
                                        <td><span class="badge bg-light text-dark border">@s.Genre</span></td>
                                        <td><span class="price-tag">@String.Format("{0:C}", s.Price)</span></td>
                                        <td class="text-end">
                                            <a asp-controller="Songs" asp-action="Details" asp-route-id="@s.SongID" class="btn btn-sm btn-link text-decoration-none">
                                                <i class="bi bi-info-circle"></i> Info
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light">
                                    <td colspan="3" class="text-end fw-bold">Total Playlist Value:</td>
                                    <td colspan="2"><h5 class="price-tag mb-0">@String.Format("{0:C}", Model.Songs.Sum(s => s.Price))</h5></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-disc text-muted mb-3" style="font-size: 3rem; display: block;"></i>
                        <p class="text-muted">No songs in this playlist yet. Start adding some!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: "Search for a song...",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
