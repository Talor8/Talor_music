@model Talor_music.Models.PlayListSong

@{
    ViewData["Title"] = "Playlist Details";
    var allSongs = ViewBag.AllSongs as IEnumerable<Talor_music.Models.Song>;
}

@* פונטים, אייקונים ו-Select2 *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Assistant', sans-serif;
    }

    .playlist-banner {
        background: linear-gradient(135deg, #4158D0 0%, #C850C0 46%, #FFCC70 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 40px 40px;
        margin-bottom: 30px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .glass-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 25px;
    }

    .add-song-section {
        background: #fff;
        padding: 25px;
        border-radius: 20px;
        border: 2px dashed #C850C0;
    }

    .select2-container--default .select2-selection--single {
        border-radius: 10px;
        height: 45px;
        border: 1px solid #ddd;
        padding-top: 8px;
    }

    .song-table thead {
        background: #f1f3f5;
    }

    .song-table th {
        border: none;
        color: #6c757d;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    .song-table tbody tr:hover {
        background: #fdf2ff;
    }

    .price-tag {
        color: #C850C0;
        font-weight: bold;
    }

    /* עיצוב לסיכום הסופי */
    .total-row {
        background-color: #f8f9fa;
        font-size: 1.1rem;
    }

    .btn-add {
        background: #C850C0;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        transition: 0.3s;
        width: 100%;
    }

        .btn-add:hover {
            background: #4158D0;
            transform: translateY(-2px);
            color: white;
        }
</style>

<div class="playlist-banner text-center">
    <div class="container">
        <i class="bi bi-collection-play mb-3" style="font-size: 3.5rem;"></i>
        <h1 class="display-4 fw-bold">@Model.Title</h1>
        <div class="d-flex justify-content-center gap-3 opacity-75">
            <span><i class="bi bi-person"></i> Customer ID: @Model.CustomerID</span>
            <span>|</span>
            <span><i class="bi bi-calendar3"></i> Added: @Model.DateAdded.ToShortDateString()</span>
        </div>
    </div>
</div>

<div class="container pb-5" dir="rtl">
    <div class="row">
        <div class="col-lg-4 mb-4 order-lg-2">
            <div class="add-song-section shadow-sm text-center">
                <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>הוספת שיר לרשימה</h5>

                <form id="addSongForm" asp-action="AddSongToListAction" method="post">
                    <input type="hidden" name="playListId" value="@Model.PlaylistSongID" />
                    <div class="mb-3 text-start">
                        <select name="songId" id="songSelect" class="select2 w-100" onchange="this.form.submit()">
                            <option value="">חפש שיר להוספה...</option>
                            @if (allSongs != null)
                            {
                                foreach (var song in allSongs)
                                {
                                    <option value="@song.SongID">@song.Title (@song.Price ₪)</option>
                                }
                            }
                        </select>
                    </div>
                    <p class="small text-muted">בחר שיר כדי להוסיף אותו מיידית</p>
                </form>
            </div>

            <div class="mt-4 d-flex justify-content-between gap-2">
                <a asp-action="Edit" asp-route-id="@Model.PlaylistSongID" class="btn btn-outline-dark flex-grow-1">עריכת פרטים</a>
                <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">חזרה</a>
            </div>
        </div>

        <div class="col-lg-8 order-lg-1">
            <div class="glass-card p-4">
                <h4 class="fw-bold mb-4"><i class="bi bi-music-note-list me-2"></i>תוכן הפלייליסט</h4>
                <div class="table-responsive">
                    <table class="table align-middle song-table">
                        <thead>
                            <tr>
                                <th>שם השיר</th>
                                <th>אמן</th>
                                <th>מחיר</th>
                                <th class="text-end">מידע</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Songs != null && Model.Songs.Any())
                            {
                                foreach (var s in Model.Songs)
                                {
                                    <tr>
                                        <td><strong>@s.Title</strong></td>
                                        <td>@(s.Artist?.Name ?? "לא ידוע")</td>
                                        <td><span class="price-tag">₪@s.Price</span></td>
                                        <td class="text-end">
                                            <a asp-controller="Songs" asp-action="Details" asp-route-id="@s.SongID" class="text-muted">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">אין שירים ברשימה זו עדיין.</td>
                                </tr>
                            }
                        </tbody>
                        @* שורת הסיכום שביקשת - עכשיו היא בעיצוב שתואם לבאנר *@
                        <tfoot class="total-row">
                            <tr>
                                <td colspan="2" class="fw-bold">סה"כ שווי הפלייליסט:</td>
                                <td colspan="2" class="fw-bold text-end" style="color: #C850C0;">
                                    ₪@(Model.Songs?.Sum(s => s.Price) ?? 0)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#songSelect').select2({
                placeholder: "הקלד שם שיר...",
                allowClear: true,
                dir: "rtl"
            });
        });
    </script>
}