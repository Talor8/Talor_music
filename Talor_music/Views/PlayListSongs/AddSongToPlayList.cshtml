@model IEnumerable<Talor_music.Models.PlayListSong>

@{
    ViewData["Title"] = "בחירת פלייליסט";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Assistant', sans-serif;
    }

    .selection-header {
        background: linear-gradient(180deg, #e91e63 0%, #f8f9fa 100%);
        padding: 50px 0;
        color: white;
        text-align: center;
        margin-bottom: 30px;
    }

    .card-playlist {
        border-radius: 15px;
        transition: transform 0.2s;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        .card-playlist:hover {
            transform: scale(1.03);
        }

    .btn-pink {
        background-color: #e91e63;
        color: white;
        border-radius: 50px;
        border: none;
    }

        .btn-pink:hover {
            background-color: #d81b60;
            color: white;
        }
</style>

<div class="selection-header">
    <div class="container">
        <i class="bi bi-plus-circle-fill" style="font-size: 3rem;"></i>
        <h2 class="fw-bold mt-2">לאיזה פלייליסט להוסיף?</h2>
        <p>בחר פלייליסט מהרשימה שלך</p>
    </div>
</div>

<div class="container text-end" dir="rtl">
    <div class="row justify-content-center">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card card-playlist h-100 p-3">
                    <div class="card-body text-center">
                        <i class="bi bi-music-note-list text-pink mb-3" style="font-size: 2rem;"></i>
                        <h5 class="fw-bold">@item.Title</h5>
                        <p class="text-muted small">נוצר ב-@item.DateAdded.ToString("dd/MM/yyyy")</p>

                        <form asp-action="AddSongToListAction" method="post">
                            <input type="hidden" name="playListId" value="@item.PlaylistSongID" />
                            <input type="hidden" name="songId" value="@ViewBag.SongId" />
                            <button type="submit" class="btn btn-pink w-100 py-2">
                                <i class="bi bi-plus-lg"></i> הוסף לכאן
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center mt-5">
            <div class="alert alert-light shadow-sm d-inline-block p-4">
                <h5>אופס, אין לך פלייליסטים עדיין...</h5>
                <a asp-action="Create" class="btn btn-pink mt-3">צור את הפלייליסט הראשון שלך</a>
            </div>
        </div>
    }

    <div class="text-center mt-4">
        <a asp-controller="Songs" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            ביטול וחזרה לחנות
        </a>
    </div>
</div>
