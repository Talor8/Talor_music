@model Talor_music.Models.PlayListSong

@{
    ViewData["Title"] = "Edit Playlist";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
        min-height: 100vh;
    }

    .form-card {
        border: none;
        border-radius: 25px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        background: white;
        overflow: hidden;
    }

    .card-header-edit {
        background: linear-gradient(45deg, #212529 0%, #434343 100%);
        color: white;
        padding: 40px;
        text-align: center;
    }

    .form-control-lg {
        border-radius: 12px;
        border: 1px solid #ddd;
    }

    .btn-update {
        background: #212529;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        transition: 0.3s;
        color: white;
    }

        .btn-update:hover {
            background: #000;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">
                <div class="card-header-edit">
                    <i class="bi bi-pencil-square mb-3" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold">Edit Playlist</h2>
                    <p class="mb-0 opacity-75">עדכון פרטי הפלייליסט הקיים</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* שדות מוסתרים שחייבים לעבור כדי שהעדכון יצליח *@
                        <input type="hidden" asp-for="PlaylistSongID" />

                        @* כותרת הפלייליסט *@
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">Playlist Title</label>
                            <input asp-for="Title" class="form-control form-control-lg" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        @* זיהוי הלקוח - אימייל במקום מספר *@
                        <div class="mb-4">
                            <label class="form-label fw-bold">Customer Email</label>
                            @if (User.IsInRole("Admin"))
                            {
                                @* מנהל יכול לשנות את בעל הפלייליסט מתוך רשימת אימיילים *@
                                <select asp-for="CustomerID" class="form-control form-control-lg" asp-items="ViewBag.CustomerID"></select>
                            }
                            else
                            {
                                @* לקוח רגיל רואה את האימייל שלו בלבד ולא יכול לשנות *@
                                <input type="text" class="form-control form-control-lg bg-light" value="@User.Identity.Name" readonly />
                                @* שומרים את ה-ID הקיים בשדה נסתר כדי שלא יתאפס *@
                                <input type="hidden" asp-for="CustomerID" />
                            }
                            <span asp-validation-for="CustomerID" class="text-danger small"></span>
                        </div>

                        @* תאריך יצירה *@
                        <div class="mb-4">
                            <label asp-for="DateAdded" class="form-label fw-bold">Date Created</label>
                            <input asp-for="DateAdded" class="form-control form-control-lg" type="date" />
                            <span asp-validation-for="DateAdded" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-update btn-lg w-100 shadow-sm">
                            <i class="bi bi-save me-2"></i> Save Changes
                        </button>
                    </form>
                </div>
                <div class="card-footer bg-light border-0 py-3 text-center">
                    <a asp-action="Index" class="text-muted text-decoration-none">
                        <i class="bi bi-x-circle me-1"></i> Cancel and go back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
