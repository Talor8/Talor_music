@model Talor_music.Models.PlayListSong

@{
    ViewData["Title"] = "Edit Playlist";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
        min-height: 100vh;
    }

    .form-card {
        border: none;
        border-radius: 25px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        background: white;
        overflow: hidden;
    }

    .card-header-edit {
        background: linear-gradient(45deg, #212529 0%, #434343 100%);
        color: white;
        padding: 40px;
        text-align: center;
    }

    .form-control-lg {
        border-radius: 12px;
        border: 1px solid #ddd;
        text-align: right;
    }

    .btn-update {
        background: #212529;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        transition: 0.3s;
        color: white;
        cursor: pointer;
    }

        .btn-update:hover {
            background: #000;
            transform: translateY(-2px);
        }

    label {
        display: block;
        text-align: right;
        margin-bottom: 8px;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">
                <div class="card-header-edit">
                    <i class="bi bi-pencil-square mb-3" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold">Edit Playlist</h2>
                    <p class="mb-0 opacity-75">עדכון שם הפלייליסט</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* שדות מוסתרים - חובה כדי שהשמירה תעבוד מבלי שהמשתמש יראה אותם *@
                        <input type="hidden" asp-for="PlaylistSongID" />
                        <input type="hidden" asp-for="CustomerID" />
                        <input type="hidden" asp-for="DateAdded" />

                        @* רק השם ניתן לעריכה *@
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">שם הפלייליסט החדש</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="הקלד שם פלייליסט..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-update btn-lg w-100 shadow-sm">
                            <i class="bi bi-save me-2"></i> שמור שינויים
                        </button>
                    </form>
                </div>
                <div class="card-footer bg-light border-0 py-3 text-center">
                    <a asp-action="Details" asp-route-id="@Model.PlaylistSongID" class="text-muted text-decoration-none">
                        <i class="bi bi-x-circle me-1"></i> ביטול וחזרה
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
