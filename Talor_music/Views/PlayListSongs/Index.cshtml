@model IEnumerable<Talor_music.Models.PlayListSong>

@{
    ViewData["Title"] = "My Playlists";
}

@* פונטים ואייקונים *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Assistant', sans-serif;
    }

    .playlist-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 50px 50px;
        margin-bottom: 40px;
        box-shadow: 0 10px 20px rgba(118, 75, 162, 0.2);
    }

    .playlist-card {
        background: white;
        border: none;
        border-radius: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border-left: 8px solid #667eea;
    }

        .playlist-card:hover {
            transform: translateX(10px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .vinyl-icon {
        font-size: 2.5rem;
        color: #764ba2;
        background: #f0edff;
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin-right: 20px;
    }

    .price-badge {
        background: #eef2ff;
        color: #4338ca;
        padding: 10px 20px;
        border-radius: 15px;
        font-weight: 800;
        font-size: 1.2rem;
        display: inline-block;
    }

    .btn-create-playlist {
        background: white;
        color: #764ba2;
        font-weight: bold;
        border-radius: 30px;
        padding: 12px 35px;
        text-decoration: none;
        transition: 0.3s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

        .btn-create-playlist:hover {
            background: #f0edff;
            transform: scale(1.05);
        }

    .action-link {
        border-radius: 10px;
        padding: 8px 15px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

    .date-text {
        font-size: 0.85rem;
        color: #6b7280;
    }
</style>

<div class="playlist-header text-center">
    <div class="container">
        <i class="bi bi-music-note-list mb-3" style="font-size: 3rem;"></i>
        <h1 class="display-4 fw-bold">My Music Collections</h1>
        <p class="lead opacity-75">ניהול הפלייליסטים האישיים שלך וסיכום עלויות</p>
        <div class="mt-4">
            <a asp-action="Create" class="btn-create-playlist">
                <i class="bi bi-plus-circle-fill me-2"></i>Create New Playlist
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3 text-muted" style="font-size: 5rem;">
                        <i class="bi bi-disc"></i>
                    </div>
                    <h3>עדיין אין לך פלייליסטים...</h3>
                    <p class="text-muted">זה הזמן ליצור את האוסף הראשון שלך!</p>
                </div>
            }

            @foreach (var item in Model)
            {
                // חישוב מחיר כולל
                var total = (item.Songs != null && item.Songs.Any()) ? item.Songs.Sum(s => s.Price) : 0m;

                <div class="card playlist-card shadow-sm p-4">
                    <div class="row align-items-center">
                        <div class="col-auto d-none d-md-block">
                            <div class="vinyl-icon">
                                <i class="bi bi-record-circle"></i>
                            </div>
                        </div>

                        <div class="col">
                            <h3 class="fw-bold mb-1">@Html.DisplayFor(modelItem => item.Title)</h3>
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-light text-dark me-3 border">
                                    <i class="bi bi-person me-1"></i> ID: @item.CustomerID
                                </span>
                                <span class="date-text">
                                    <i class="bi bi-calendar3 me-1"></i> @item.DateAdded.ToShortDateString()
                                </span>
                            </div>
                        </div>

                        <div class="col-md-auto text-center my-3 my-md-0">
                            <div class="text-muted small mb-1 text-uppercase fw-bold">Total Value</div>
                            <div class="price-badge">
                                @String.Format("{0:C}", total)
                            </div>
                        </div>

                        <div class="col-md-auto d-flex flex-md-column gap-2">
                            <a asp-action="Details" asp-route-id="@item.PlaylistSongID" class="btn btn-outline-primary btn-sm rounded-pill">
                                <i class="bi bi-info-circle me-1"></i> View Details
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.PlaylistSongID" class="btn btn-outline-secondary btn-sm rounded-pill flex-grow-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.PlaylistSongID" class="btn btn-outline-danger btn-sm rounded-pill flex-grow-1">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
