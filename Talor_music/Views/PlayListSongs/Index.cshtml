@model IEnumerable<Talor_music.Models.PlayListSong>

@{
    ViewData["Title"] = "My Playlists";
}

@* פונטים ואייקונים *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Assistant', sans-serif;
    }

    .playlist-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 50px 50px;
        margin-bottom: 40px;
        box-shadow: 0 10px 20px rgba(118, 75, 162, 0.2);
    }

    .playlist-card {
        background: white;
        border: none;
        border-radius: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border-right: 8px solid #667eea;
    }

        .playlist-card:hover {
            transform: scale(1.01);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .vinyl-icon {
        font-size: 2.5rem;
        color: #764ba2;
        background: #f0edff;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .price-badge {
        background: #f0edff;
        color: #764ba2;
        padding: 8px 18px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 1.1rem;
        border: 1px solid #dcd3ff;
    }

    .btn-create-playlist {
        background: white;
        color: #764ba2;
        font-weight: bold;
        border-radius: 30px;
        padding: 12px 35px;
        text-decoration: none;
        transition: 0.3s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

        .btn-create-playlist:hover {
            background: #f0edff;
            color: #667eea;
        }

    .customer-badge {
        background: #fff4e5;
        color: #b95000;
        padding: 3px 10px;
        border-radius: 8px;
        font-size: 0.8rem;
    }
</style>

<div class="playlist-header text-center">
    <div class="container">
        <i class="bi bi-music-note-list mb-3" style="font-size: 3rem;"></i>
        <h1 class="display-4 fw-bold">My Music Collections</h1>
        <p class="lead opacity-75">ניהול הפלייליסטים האישיים שלך וסיכום עלויות</p>
        <div class="mt-4">
            <a asp-action="Create" class="btn-create-playlist">
                <i class="bi bi-plus-circle-fill me-2"></i>Create New Playlist
            </a>
        </div>
    </div>
</div>

<div class="container pb-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-disc text-muted" style="font-size: 5rem;"></i>
                    <h3 class="mt-3">עדיין אין לך פלייליסטים...</h3>
                    <p class="text-muted">זה הזמן ליצור את האוסף הראשון שלך!</p>
                </div>
            }

            @foreach (var item in Model)
            {
                var total = item.Songs?.Sum(s => s.Price) ?? 0;

                <div class="card playlist-card shadow-sm p-3">
                    <div class="row align-items-center text-center text-md-end">
                        <div class="col-md-1 d-none d-md-block">
                            <div class="vinyl-icon">
                                <i class="bi bi-record-circle"></i>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <h3 class="fw-bold mb-1">@item.Title</h3>
                            <div class="d-flex justify-content-center justify-content-md-start gap-2 align-items-center">
                                <span class="text-muted small"><i class="bi bi-calendar3"></i> @item.DateAdded.ToShortDateString()</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="customer-badge">@item.Customer?.Email</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-3 my-3 my-md-0">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Total Value</div>
                            <div class="price-badge">
                                ₪@total.ToString("N2")
                            </div>
                        </div>

                        <div class="col-md-4 d-flex justify-content-center justify-content-md-end gap-2">
                            <a asp-controller="Checkout" asp-action="Index" asp-route-playlistId="@item.PlaylistSongID" class="btn btn-success rounded-pill px-3">
                                <i class="bi bi-cart-fill"></i> קנה פלייליסט
                            </a>

                            <a asp-action="Details" asp-route-id="@item.PlaylistSongID" class="btn btn-primary rounded-pill px-3">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.PlaylistSongID" class="btn btn-outline-secondary rounded-pill">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.PlaylistSongID" class="btn btn-outline-danger rounded-pill">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
