@model IEnumerable<Talor_music.Models.Customer>

@{
    ViewData["Title"] = "ניהול לקוחות";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f8f9fa;
    }

    .page-header {
        background: #ffffff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        margin-bottom: 30px;
        border-right: 5px solid #0d6efd; /* פס כחול בצד */
    }

    .customer-table {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .table thead {
        background-color: #f1f4f9;
    }

    .table th {
        border: none;
        color: #495057;
        font-weight: 600;
        padding: 20px;
    }

    .table td {
        vertical-align: middle;
        padding: 15px 20px;
        border-color: #f1f4f9;
    }

    .action-link {
        text-decoration: none;
        font-weight: 500;
        margin-left: 10px;
        transition: 0.2s;
    }

    .btn-edit {
        color: #0d6efd;
    }

    .btn-details {
        color: #6c757d;
    }

    .btn-delete {
        color: #dc3545;
    }

    .action-link:hover {
        opacity: 0.7;
        text-decoration: underline;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        background-color: #e9ecef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        font-size: 1.2rem;
    }
</style>

<div class="container py-5">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-0">ניהול לקוחות</h1>
            <p class="text-muted mb-0">צפייה וניהול המשתמשים הרשומים באתר</p>
        </div>
        <div class="stats">
            <span class="badge bg-primary rounded-pill p-2 px-3">
                <i class="bi bi-people-fill me-1"></i>
                סה"כ לקוחות: @Model.Count()
            </span>
        </div>
    </div>

    <div class="customer-table">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th style="width: 50px;"></th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th class="text-center">פעולות ניהול</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="avatar-circle">
                                <i class="bi bi-person"></i>
                            </div>
                        </td>
                        <td class="fw-bold">
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            <i class="bi bi-envelope me-2 text-muted"></i>
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-link btn-edit">
                                <i class="bi bi-pencil-square"></i> ערוך
                            </a>
                            <span class="text-muted">|</span>
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-link btn-details">
                                <i class="bi bi-info-circle"></i> פרטים
                            </a>
                            <span class="text-muted">|</span>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-link btn-delete">
                                <i class="bi bi-trash"></i> מחק
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
