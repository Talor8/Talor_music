@model Talor_music.Models.Customer

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class="mt-4">
    <h4>
        <i class="bi bi-music-note-list me-2"></i>הפלייליסטים של @Model.Name
    </h4>

    @if (Model.Playlists != null && Model.Playlists.Any())
    {
        <div class="row mt-3">
            @foreach (var playlist in Model.Playlists)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100 border-start border-4 border-primary">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@playlist.Title</h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-calendar3"></i> נוצר ב: @playlist.DateAdded.ToShortDateString()
                            </p>

                            @* כפתור שמעביר ישירות לפלייליסט עצמו *@
                            <a asp-controller="PlayListSongs"
                               asp-action="Details"
                               asp-route-id="@playlist.PlaylistSongID"
                               class="btn btn-outline-primary btn-sm stretched-link">
                                צפייה בפלייליסט
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light mt-3" role="alert">
            <i class="bi bi-info-circle me-2"></i>ללקוח זה עדיין אין פלייליסטים.
        </div>
    }
</div>
<br />
