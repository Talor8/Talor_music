<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Talor_music</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .navbar-dark .navbar-nav .nav-link {
            color: rgba(255,255,255,.8);
            font-weight: 500;
        }

            .navbar-dark .navbar-nav .nav-link:hover {
                color: #1db954;
            }

        .nav-admin {
            color: #ffc107 !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="color: #1db954;"><i class="bi bi-vinyl-fill"></i></span> Talor_music
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Songs" asp-action="Index">Store</a>
                        </li>
                        <li class="nav-item">
                            @* קישור אחד ויחיד לאמנים - כולם רואים אותו *@
                            <a class="nav-link" asp-controller="Artists" asp-action="Index">Artists</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PlayListSongs" asp-action="Index">
                                <i class="bi bi-music-note-list"></i> My Playlists
                            </a>
                        </li>

                        @* רק למנהל - ניהול לקוחות *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-admin" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people-fill"></i> Admin: Customers
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-dark py-3">
        <div class="container text-center text-light opacity-50">
            &copy; 2026 - Talor_music - <i class="bi bi-heart-fill text-success"></i> Music is Life
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>